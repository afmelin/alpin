<section class="section{% if section.settings.alt_bg %} section-alt{% endif %}" id="faq">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head center"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="faq-answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vanliga frågor",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vanliga frågor" },
    { "type": "checkbox", "id": "alt_bg", "label": "Vit bakgrund", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        { "type": "text", "id": "question", "label": "Fråga", "default": "Fråga" },
        { "type": "richtext", "id": "answer", "label": "Svar", "default": "<p>Svar</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vanliga frågor",
      "blocks": [
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
