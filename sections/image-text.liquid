{%- comment -%}
  Bild eller video bredvid text, med valfri knapp.
  Används för videosektionen och presentsektionen på startsidan.
{%- endcomment -%}
<section class="section{% if section.settings.alt_bg %} section-alt{% endif %}">
  <div class="wrap split{% if section.settings.image_right %} split-reverse{% endif %}">
    <div>
      {%- assign video = section.settings.video_url -%}
      {%- if video != blank and video.type == 'youtube' -%}
        <div class="video">
          <iframe src="https://www.youtube-nocookie.com/embed/{{ video.id }}?rel=0" title="{{ section.settings.heading | escape }}" loading="lazy" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        </div>
      {%- elsif video != blank and video.type == 'vimeo' -%}
        <div class="video">
          <iframe src="https://player.vimeo.com/video/{{ video.id }}" title="{{ section.settings.heading | escape }}" loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      {%- elsif section.settings.show_video_placeholder and section.settings.image == blank -%}
        {% render 'placeholder', label: section.settings.image_label, class: 'ph-wide ph-video' %}
      {%- else -%}
        {% render 'media', image: section.settings.image, label: section.settings.image_label, sizes: '(min-width: 900px) 50vw, 100vw' %}
      {%- endif -%}
    </div>

    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}

      {%- assign p = section.settings.product -%}
      {%- if p != blank and p.available -%}
        {%- form 'product', p -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="btn btn-primary">
            {{ section.settings.button_label }} – {{ p.selected_or_first_available_variant.price | money }}
          </button>
        {%- endform -%}
      {%- elsif section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild/video med text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "video_url", "id": "video_url", "label": "Video (YouTube eller Vimeo)", "accept": ["youtube", "vimeo"], "info": "Visas i stället för bilden." },
    { "type": "text", "id": "image_label", "label": "Text i tom bildruta", "default": "Bild" },
    { "type": "checkbox", "id": "show_video_placeholder", "label": "Visa tom ruta som video", "default": false },
    { "type": "checkbox", "id": "image_right", "label": "Bild till höger", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Liten rubrik" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Rubrik" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" },
    { "type": "product", "id": "product", "label": "Köpknapp för produkt", "info": "Knappen lägger produkten i varukorgen. Lämna tom för att använda länken nedan." },
    { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Köp nu" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" },
    { "type": "checkbox", "id": "alt_bg", "label": "Vit bakgrund", "default": false }
  ],
  "presets": [
    { "name": "Bild/video med text" }
  ]
}
{% endschema %}
