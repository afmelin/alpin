<section class="section{% if section.settings.alt_bg %} section-alt{% endif %}">
  <div class="wrap">
    <div class="section-head center">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="grid-3">
      {%- for block in section.blocks -%}
        <article class="card benefit" {{ block.shopify_attributes }}>
          {% render 'media', image: block.settings.image, label: block.settings.image_label, sizes: '(min-width: 900px) 33vw, 100vw' %}
          <h3>{{ block.settings.title }}</h3>
          <div class="muted">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fördelar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Med rätt morot kommer skidglädjen snabbt" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>De första gångerna i skidbacken är inte alltid så roliga. Det är kallt, pjäxorna klämmer och det är lätt att ramla. Skidmärken gör varje åk till ett steg framåt.</p>" },
    { "type": "checkbox", "id": "alt_bg", "label": "Vit bakgrund", "default": true }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Fördel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "image_label", "label": "Text i tom bildruta", "default": "Bild" },
        { "type": "text", "id": "title", "label": "Rubrik", "default": "Fördel" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Beskriv fördelen.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Fördelar",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
