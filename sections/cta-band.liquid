<section class="section">
  <div class="wrap">
    <div class="cta-band">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="cta-text">{{ section.settings.text }}</div>{%- endif -%}

      {%- assign p = section.settings.product -%}
      {%- if p != blank and p.available -%}
        {%- form 'product', p -%}
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="btn btn-primary">
            {{ section.settings.button_label }} – {{ p.selected_or_first_available_variant.price | money }}
          </button>
        {%- endform -%}
      {%- elsif section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Köpuppmaning",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Gör skidresan till ett minne för livet" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Märkessköld + 4 skidmärken. Skickas inom 1–2 vardagar.</p>" },
    { "type": "product", "id": "product", "label": "Köpknapp för produkt", "info": "Knappen lägger produkten i varukorgen. Lämna tom för att använda länken nedan." },
    { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Köp nu" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" }
  ],
  "presets": [
    { "name": "Köpuppmaning" }
  ]
}
{% endschema %}
