{%- if section.settings.text != blank -%}
  <div class="announce">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      {{ section.settings.text }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Kampanjrad",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Fri frakt över 499 kr · <strong>Beställ före resan</strong> – skickas inom 1–2 vardagar"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk (valfritt)"
    }
  ]
}
{% endschema %}
