<div class="wrap">
  <div class="page-head prose center-text password-page">
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="lead">{{ shop.password_message }}</p>
    {%- else -%}
      <p class="lead">Webbshoppen öppnar snart!</p>
    {%- endif -%}

    <details class="card">
      <summary>Har du lösenordet?</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<div class="notice" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="password">Lösenord</label>
          <input id="password" type="password" name="password" autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-primary btn-small">Gå in</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Lösenordssida"
}
{% endschema %}
