{%- comment -%}
  Kundbilder och omdömen. Omdömen visas bara när de har lagts in,
  så att inga påhittade omdömen syns på sidan.
{%- endcomment -%}
<section class="section{% if section.settings.alt_bg %} section-alt{% endif %}">
  <div class="wrap">
    <div class="section-head center">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="muted">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- assign photos = section.blocks | where: 'type', 'photo' -%}
    {%- assign reviews = section.blocks | where: 'type', 'review' -%}

    <div class="ugc">
      {%- if photos.size > 0 -%}
        {%- for block in photos -%}
          <div {{ block.shopify_attributes }}>
            {% render 'media', image: block.settings.image, label: 'Kundbild', class: 'ph-square', sizes: '(min-width: 641px) 16vw, 33vw' %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          {% render 'placeholder', label: 'Kundbild', class: 'ph-square' %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if reviews.size > 0 -%}
      <div class="reviews">
        {%- for block in reviews -%}
          <figure class="card review" {{ block.shopify_attributes }}>
            {%- if block.settings.rating > 0 -%}
              <p class="stars" aria-label="{{ block.settings.rating }} av 5 stjärnor">
                {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
              </p>
            {%- endif -%}
            <blockquote>{{ block.settings.quote }}</blockquote>
            <figcaption>{{ block.settings.author }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kundbilder och omdömen",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Från backen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Bilder från familjer som samlar märken. Dela era egna på Instagram!</p>" },
    { "type": "checkbox", "id": "alt_bg", "label": "Vit bakgrund", "default": true }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Kundbild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" }
      ]
    },
    {
      "type": "review",
      "name": "Omdöme",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Omdöme" },
        { "type": "text", "id": "author", "label": "Namn och ort" },
        { "type": "range", "id": "rating", "label": "Betyg (0 = dölj)", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    { "name": "Kundbilder och omdömen" }
  ]
}
{% endschema %}
