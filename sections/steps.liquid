<section class="section{% if section.settings.alt_bg %} section-alt{% endif %}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="section-head center"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Så funkar det",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Så funkar det" },
    { "type": "checkbox", "id": "alt_bg", "label": "Vit bakgrund", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Steg",
      "settings": [
        { "type": "text", "id": "title", "label": "Rubrik", "default": "Steg" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Så funkar det",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
